# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=contacts_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800
RESET_TOKEN_EXPIRATION_SECONDS=3600

# Redis (user cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me
USER_CACHE_TTL_SECONDS=900

# Mail
# Defaults below use the local Mailpit container (web UI: http://localhost:8025).
# For a real SMTP server (e.g. smtp.meta.ua:465) set MAIL_SERVER, MAIL_PORT,
# MAIL_SSL_TLS=True, MAIL_USE_CREDENTIALS=True, MAIL_VALIDATE_CERTS=True,
# MAIL_USERNAME/MAIL_PASSWORD, and DOCKER_MAIL_SERVER to the same host as MAIL_SERVER.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Contacts API
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
MAIL_USE_CREDENTIALS=False
MAIL_VALIDATE_CERTS=False
# SMTP host used by the app container in Docker Compose (default: mailpit)
DOCKER_MAIL_SERVER=mailpit

# Cloudinary (https://console.cloudinary.com -> Settings -> API Keys)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS: comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
